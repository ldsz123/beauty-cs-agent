# 电商智能客服Agent — 环境变量配置
# 复制为 .env 并填写实际值

# ====== LLM 配置（必填） ======
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ====== API 认证 ======
# 多个 key 用逗号分隔
API_KEYS=change-me

# ====== 存储模式 ======
# SESSION_MODE: memory(默认) / postgres / redis
SESSION_MODE=postgres
# KB_MODE: builtin(默认) / postgres / redis
KB_MODE=postgres

# ====== PostgreSQL 配置 ======
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://cs_user:change-me@localhost:5432/cs_agent
DB_PASSWORD=change-me

# ====== Redis 配置 ======
REDIS_URL=redis://:change-me@localhost:6379
REDIS_PASSWORD=change-me

# ====== CORS 配置 ======
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ====== 限流配置 ======
RATE_LIMIT_IP=60
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_SESSION=20
RATE_LIMIT_SESSION_WINDOW=60

# ====== Sentry（可选） ======
SENTRY_DSN=
